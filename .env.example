# AgriDrone AutoMap — Root Environment Template
# Port Allocation to avoid conflicts with existing services:
# Frontend: 3005 | Backend: 8005 | PostGIS: 5434 | Redis: 6380

# Environment Mode
ENVIRONMENT=development
PROJECT_NAME="AgriDrone AutoMap"
API_V1_STR=/api/v1
SECRET_KEY=dev_insecure_secret_key_change_in_production_min_32_chars_long

# Database (PostgreSQL 16 + PostGIS 3.4)
DATABASE_URL=postgresql://agridrone_user:local_pass@localhost:5434/agridrone_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_TIMEOUT_SECONDS=5

# Redis Cache / Broker
REDIS_URL=redis://localhost:6380/0

# Allowed CORS Origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:3005"]

# Logging
LOG_LEVEL=INFO

# Microsoft Azure Blob Storage (Phase 5)
# Set your Azure storage connection string here for cloud uploads.
# If left empty, local development storage fallback is automatically used in backend/storage/
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_NAME=agridronestorage
AZURE_CONTAINER_RAW=raw-surveys
AZURE_CONTAINER_ORTHO=orthomosaics
AZURE_CONTAINER_INDICES=vegetation-indices
AZURE_CONTAINER_REPORTS=reports
LOCAL_STORAGE_PATH=storage
MAX_UPLOAD_SIZE_BYTES=524288000
ALLOW_DEV_LOCAL_STORAGE=true

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8005/api/v1

# WebODM Photogrammetry Service (Phase 6)
WEBODM_API_URL=http://localhost:3001
WEBODM_USERNAME=admin
WEBODM_PASSWORD=admin
WEBODM_PROJECT_ID=
WEBODM_TOKEN=
WEBODM_TIMEOUT_SECONDS=30
WEBODM_POLL_INTERVAL_SECONDS=10
WEBODM_MAX_RETRIES=3

# --- Authentication & Authorization (Phase 9) ---
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
AUTH_RATE_LIMIT_PER_MINUTE=20


