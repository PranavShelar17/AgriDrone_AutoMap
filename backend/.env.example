# AgriDrone AutoMap — Backend Environment Configuration Example
# Copy this file to .env and configure for local development

# Environment Mode: development | staging | production
ENVIRONMENT=development
PROJECT_NAME="AgriDrone AutoMap"
API_V1_STR=/api/v1
SECRET_KEY=dev_insecure_secret_key_change_in_production_min_32_chars_long

# PostgreSQL with PostGIS Database Connection
# Dedicated development port 5434 avoids collisions with default Postgres on 5432
DATABASE_URL=postgresql://agridrone_user:local_pass@localhost:5434/agridrone_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_TIMEOUT_SECONDS=5

# Redis Message Broker & Cache Connection
# Dedicated development port 6380 avoids collisions with default Redis on 6379
REDIS_URL=redis://localhost:6380/0

# CORS Allowed Origins (Comma-separated or JSON list)
CORS_ORIGINS=["http://localhost:3000","http://localhost:3005"]

# Logging Level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# --- Microsoft Azure Blob Storage (Phase 5) ---
# If left empty, the application automatically activates the local-development storage adapter (backend/storage/)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_NAME=agridronestorage
AZURE_CONTAINER_RAW=raw-surveys
AZURE_CONTAINER_ORTHO=orthomosaics
AZURE_CONTAINER_INDICES=vegetation-indices
AZURE_CONTAINER_REPORTS=reports
LOCAL_STORAGE_PATH=storage
MAX_UPLOAD_SIZE_BYTES=524288000
ALLOW_DEV_LOCAL_STORAGE=true

# WebODM Photogrammetry Service (Phase 6 - Reconstruction Cluster)
WEBODM_API_URL=http://localhost:3001
WEBODM_USERNAME=admin
WEBODM_PASSWORD=admin
WEBODM_PROJECT_ID=
WEBODM_TOKEN=
WEBODM_TIMEOUT_SECONDS=30
WEBODM_POLL_INTERVAL_SECONDS=10
WEBODM_MAX_RETRIES=3

# --- Authentication & Authorization (Phase 9) ---
# Token signature algorithm (HS256 for symmetric key, RS256 for asymmetric)
JWT_ALGORITHM=HS256
# Session token lifespan in minutes (default: 480 minutes / 8 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=480
# Set to true in HTTPS production deployments
COOKIE_SECURE=false
# SameSite cookie policy: lax | strict | none
COOKIE_SAMESITE=lax
# Authentication brute-force protection rate limit per IP per minute
AUTH_RATE_LIMIT_PER_MINUTE=20


